# Request a free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key

# Optional public API URL. Amplify builds read it from amplify_outputs.json.
# Leave blank for the local Vite API handlers.
VITE_API_BASE_URL=

# Optional public Ko-fi profile override. Defaults to relointel.
VITE_KOFI_URL=https://ko-fi.com/relointel

# Server-only key. Request one at https://api.data.gov/signup/
DATA_GOV_API_KEY=your_data_gov_api_key

# Optional dedicated EIA key; DATA_GOV_API_KEY is used when this is empty.
EIA_API_KEY=

# Optional server-only key for county GDP. Request one at https://apps.bea.gov/api/signup/
BEA_API_KEY=your_bea_api_key

# Optional server-only key for live and typical traffic-aware routing.
# Request one at https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key

# Optional server-only ArcGIS credential entitled to the World Traffic service.
# Required for citywide typical traffic by weekday and local time.
ARCGIS_API_KEY=
