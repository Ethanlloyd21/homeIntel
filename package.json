{
  "name": "home-intel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader native",
    "build": "tsc -b && vite build --config vite.config.ts --configLoader native",
    "preview": "vite preview --config vite.config.ts --configLoader native",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "data:update": "node scripts/update-zillow-data.mjs",
    "build:with-data": "npm run data:update && npm run build",
    "validate": "node scripts/validate-homeintel.mjs",
    "validate:with-data": "node scripts/validate-homeintel.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "typescript": "latest",
    "vite": "latest",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.66.0"
  }
}
