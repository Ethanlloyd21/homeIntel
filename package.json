{
  "name": "relointel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --configLoader native",
    "build": "tsc -b && vite build --config vite.config.ts --configLoader native",
    "preview": "vite preview --config vite.config.ts --configLoader native",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "data:update": "node scripts/update-zillow-data.mjs",
    "data:storms": "node scripts/build-storm-history.mjs",
    "build:with-data": "npm run data:update && npm run build",
    "validate": "node scripts/validate-homeintel.mjs",
    "validate:with-data": "node scripts/validate-homeintel.mjs",
    "typecheck:backend": "tsc --project amplify/tsconfig.json",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs",
    "sandbox": "ampx sandbox"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/lib-dynamodb": "^3.1138.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.66.0"
  },
  "imports": {
    "#api": "./src/utils/api.ts"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
